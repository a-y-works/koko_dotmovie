[
  {
    "start": 8,
    "end": 12.04567180031864,
    "text": "てのひらに\nつち を ひとにぎり。",
    "chapter": "一 ── てのひら",
    "effect": "soft"
  },
  {
    "start": 12.04567180031864,
    "end": 16.38130642591609,
    "text": "おもい。\nつめたい。\nちょっと、あまい。",
    "chapter": "一 ── てのひら",
    "effect": "soft"
  },
  {
    "start": 16.38130642591609,
    "end": 22.166755177907593,
    "text": "この ひとにぎり の なかに\nいきもの が\nなんびゃくおく。",
    "chapter": "一 ── てのひら",
    "effect": "wave"
  },
  {
    "start": 22.166755177907593,
    "end": 25.632501327668614,
    "text": "かぞえた ひと が\nいる。",
    "chapter": "一 ── てのひら",
    "effect": "wave"
  },
  {
    "start": 25.632501327668614,
    "end": 30.548061603823687,
    "text": "みえない。\nきこえない。\nなまえ も しらない。",
    "chapter": "一 ── てのひら",
    "effect": "soft"
  },
  {
    "start": 30.548061603823687,
    "end": 34.0,
    "text": "でも、\nいる。",
    "chapter": "一 ── てのひら",
    "effect": "wave"
  },
  {
    "start": 34,
    "end": 37.78673700075358,
    "text": "わたし が\nはたけ で\nいちばん さいしょに",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 37.78673700075358,
    "end": 40.61266013564431,
    "text": "おぼえた ことば は",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 40.61266013564431,
    "end": 43.43858327053504,
    "text": "「駆除」",
    "chapter": "二 ── 駆除",
    "effect": "shake"
  },
  {
    "start": 43.43858327053504,
    "end": 46.26450640542577,
    "text": "だった。",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 46.26450640542577,
    "end": 50.6446872645064,
    "text": "くさ を とる。\nむし を とる。\nきん を ころす。",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 50.6446872645064,
    "end": 53.47061039939713,
    "text": "とって\nとって\nとって",
    "chapter": "二 ── 駆除",
    "effect": "shake"
  },
  {
    "start": 53.47061039939713,
    "end": 56.545214770158246,
    "text": "はたけ は\nきれいに なった。",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 56.545214770158246,
    "end": 60.094574227581006,
    "text": "きれいに なって、\nしずかに なった。",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 60.094574227581006,
    "end": 64.0,
    "text": "しずかすぎる、と\nおもった あさ が\nあった。",
    "chapter": "二 ── 駆除",
    "effect": "soft"
  },
  {
    "start": 64,
    "end": 66.54386875713841,
    "text": "スギナ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 66.54386875713841,
    "end": 70.27318035510332,
    "text": "── つくし が、\nおとな に なった すがた。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 70.27318035510332,
    "end": 72.81704911224173,
    "text": "カラスノエンドウ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 72.81704911224173,
    "end": 76.9737306614059,
    "text": "── こども が さや を\nふえ に する、あの まめ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 76.9737306614059,
    "end": 79.51759941854431,
    "text": "ナナホシテントウ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 79.51759941854431,
    "end": 82.06146817568272,
    "text": "── てんとうむし。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 82.06146817568272,
    "end": 84.60533693282113,
    "text": "ヒラタアブ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 84.60533693282113,
    "end": 89.83044335998342,
    "text": "── はち の ふり を した、はえ。\nこども は、アブラムシ を たべる。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 89.83044335998342,
    "end": 92.37431211712183,
    "text": "ミミズ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 92.37431211712183,
    "end": 95.8899387394871,
    "text": "── つち を たべて、\nつち を つくる。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 95.8899387394871,
    "end": 98.43380749662552,
    "text": "ぜんぶ、\nわたし が",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 98.43380749662552,
    "end": 100.98785172879248,
    "text": "「雑草」とか\n「害虫」とか",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 100.98785172879248,
    "end": 103.53172048593089,
    "text": "よんで きた もの。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 103.53172048593089,
    "end": 106.40629218149729,
    "text": "なまえ を\nしって しまう と、",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 106.40629218149729,
    "end": 108.9501609386357,
    "text": "もう、\nころせない。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 108.9501609386357,
    "end": 113.00000000000004,
    "text": "てき は\nなまえ を しらない あいだ だけ\nてき だ。",
    "chapter": "三 ── なまえ",
    "effect": "soft"
  },
  {
    "start": 113,
    "end": 115.00698080279233,
    "text": "ごおくねん。",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 115.00698080279233,
    "end": 118.11780104712042,
    "text": "だれも たがやさなかった のに\nこの ほし は\nずっと",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 118.11780104712042,
    "end": 120.12478184991275,
    "text": "みどり だった。",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 120.12478184991275,
    "end": 123.57277486910996,
    "text": "ハチ が はこび、\nミミズ が たがやし、\nキン が くばり、",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 123.57277486910996,
    "end": 125.57975567190229,
    "text": "クサ が まもった。",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 125.57975567190229,
    "end": 128.6062827225131,
    "text": "わたし の トマト も、\nわたし の スイカ も、",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 128.6062827225131,
    "end": 130.9584642233857,
    "text": "わたし ひとり では\nみのらない。",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 130.9584642233857,
    "end": 133.64781849912742,
    "text": "はたけ は\nわたし の もの では ない。",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 133.64781849912742,
    "end": 136.00000000000003,
    "text": "わたし が\nはたけ の\nいちぶ だ。",
    "chapter": "四 ── ごおくねん",
    "effect": "soft"
  },
  {
    "start": 136,
    "end": 139.75161180861895,
    "text": "あしたも\nくさ は はえる。\nむし は くる。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 139.75161180861895,
    "end": 142.46623685103495,
    "text": "なおらない。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 142.46623685103495,
    "end": 145.18086189345095,
    "text": "── ちがう。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 145.18086189345095,
    "end": 148.8184594502884,
    "text": "けが を する と\nかさぶた が できる。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 148.8184594502884,
    "end": 151.5330844927044,
    "text": "はがしたく なる。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 151.5330844927044,
    "end": 155.5127248048863,
    "text": "でも あれ は、\nなおって いる とちゅう だ。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 155.5127248048863,
    "end": 159.83440787241258,
    "text": "つち が むきだし に なる と、\nくさ が はえる。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 159.83440787241258,
    "end": 162.5490329148286,
    "text": "おなじ こと だ。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 162.5490329148286,
    "end": 167.3267729894808,
    "text": "くさ が かれて、\nつち に なって、\nまた、くさ が はえる。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 167.3267729894808,
    "end": 171.42042755344414,
    "text": "この はたけ は\nいきて いる\nと いう こと だ。",
    "chapter": "五 ── きこえる",
    "effect": "wave"
  },
  {
    "start": 171.42042755344414,
    "end": 174.13505259586015,
    "text": "しずかに して。",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 174.13505259586015,
    "end": 176.84967763827615,
    "text": "きこえる。",
    "chapter": "五 ── きこえる",
    "effect": "wave"
  },
  {
    "start": 176.84967763827615,
    "end": 181.2853749575839,
    "text": "ごおくねん まえ から\nここ で\nうたって いた もの が",
    "chapter": "五 ── きこえる",
    "effect": "soft"
  },
  {
    "start": 181.2853749575839,
    "end": 183.99999999999991,
    "text": "いる。",
    "chapter": "五 ── きこえる",
    "effect": "wave"
  },
  {
    "start": 214,
    "end": 218.97822028624768,
    "text": "ここに いる。",
    "chapter": "終 ── ここにいる",
    "effect": "wave"
  },
  {
    "start": 218.97822028624768,
    "end": 223.95644057249535,
    "text": "ぜんぶ、\nここに いる。",
    "chapter": "終 ── ここにいる",
    "effect": "wave"
  },
  {
    "start": 223.95644057249535,
    "end": 230.00000000000003,
    "text": "わたし も、\nその なか の\nひとつ。",
    "chapter": "終 ── ここにいる",
    "effect": "soft"
  }
]